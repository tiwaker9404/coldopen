DATABASE_URL=postgres://postgres:postgres@localhost:5432/coldopen
FILMS_DIR=./films
PUBLIC_URL=http://localhost:8080
API_KEYS=

# Script writer: none = built-in deterministic writer (free, offline)
LLM_PROVIDER=none
# Free local model with Ollama:
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
LLM_API_KEY=ollama

WORKER_CONCURRENCY=2
ALLOW_PRIVATE_NETWORKS=false

# Slack bot (optional): see docs/SLACK.md
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
