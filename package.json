{
  "name": "coldopen",
  "version": "1.0.0",
  "description": "Paste a company's URL, get a 30-second on-brand pitch film. An AI agent that researches, writes and renders personalized video.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "author": "Ashwin",
  "repository": {
    "type": "git",
    "url": "https://github.com/tiwaker9404/coldopen"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.28.0",
  "bin": {
    "coldopen": "src/cli.ts"
  },
  "scripts": {
    "film": "node src/cli.ts",
    "start": "node src/main.ts all",
    "start:api": "node src/main.ts api",
    "start:worker": "node src/main.ts worker",
    "migrate": "node src/main.ts migrate",
    "dashboard:dev": "vite --config dashboard/vite.config.ts",
    "dashboard:build": "vite build --config dashboard/vite.config.ts",
    "dashboard:build:demo": "VITE_DEMO=1 vite build --config dashboard/vite.config.ts",
    "demo:fixtures": "node scripts/demo-fixtures.ts",
    "reels:stills": "node launch/stills.ts",
    "reel": "node launch/role-reel.ts",
    "fixtures": "node fixtures/serve.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p dashboard/tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run test/unit test/integration test/runtime",
    "evals": "node evals/run.ts",
    "eval:fit": "node evals/fit/run.ts",
    "eval:extract": "node evals/extract/run.ts",
    "eval:resume": "node evals/resume/run.ts",
    "test:chaos": "vitest run test/chaos",
    "db:test": "docker run -d --rm --name coldopen-test-pg -p 5432:5432 -e POSTGRES_HOST_AUTH_METHOD=trust postgres:17-alpine",
    "coldopen": "node src/cli.ts",
    "share:setup": "node share/setup.ts",
    "share:deploy": "node share/deploy.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.1.0",
    "@opentelemetry/core": "^3.1.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.0",
    "@opentelemetry/resources": "^3.1.0",
    "@opentelemetry/sdk-trace": "^3.1.0",
    "@prometheus-io/client": "^0.16.1",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "mammoth": "1.13.0",
    "pino": "^10.4.0",
    "postgres": "^4.1.0",
    "puppeteer": "^25.16.0",
    "unpdf": "2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@tanstack/react-query": "^5.107.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "^4.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "puppeteer",
      "@biomejs/biome",
      "esbuild"
    ]
  }
}
